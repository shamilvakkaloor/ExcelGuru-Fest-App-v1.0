rules_version = '2';

// ══════════════════════════════════════════════════════════════════════
//  Fest Tabulation — Security Rules
//
//  There is no server in this app. These rules ARE the permission system:
//  every restriction in the interface is backed by a rule here, and the
//  interface hiding a button is only cosmetic. If you change one, change
//  the other.
//
//  Paste this whole file into Firebase console → Firestore → Rules → Publish.
// ══════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identity helpers ─────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function role() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? profile().role : "public";
    }
    function refId() {
      return profile().refId;
    }
    function isAdmin()   { return role() == "admin"; }
    function isCoAdmin() { return role() == "coAdmin"; }
    function isStaff()   { return isAdmin() || isCoAdmin(); }
    function isJudge()   { return role() == "judge"; }
    function isHouse()   { return role() == "house"; }
    // The stage crew. Reads entries so they can call people up, letters them,
    // and ticks them in. Cannot score, finalize or publish.
    function isStage()   { return role() == "stage"; }

    // The fest has not been created yet. Only true once, during first-run
    // setup — writing config/festSettings closes this window for good.
    function inBootstrap() {
      return !exists(/databases/$(database)/documents/config/festSettings);
    }

    function settings() {
      return get(/databases/$(database)/documents/config/festSettings).data;
    }
    function limits() {
      return get(/databases/$(database)/documents/config/participantLimits).data;
    }
    function eventDoc(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }
    function assignedToEvent(eventId) {
      return exists(/databases/$(database)/documents/judgeAssignments/$(eventId + "_" + request.auth.uid));
    }

    // I14 — a published event is frozen.
    //
    // The Judging screen renders read-only when a result is published, but
    // that is only cosmetic. THIS is the enforcement: while an event's
    // result says Published, nobody — not even an Admin — may write a score
    // or an absence flag for it. Unpublish on the Results screen first.
    function resultPublished(eventId) {
      return exists(/databases/$(database)/documents/results/$(eventId))
        && get(/databases/$(database)/documents/results/$(eventId)).data.publishStatus == "Published";
    }

    // The appeal window closes itself. publishedAtMs is plain epoch
    // milliseconds set alongside the server timestamp at publish time —
    // rules can only compare request.time against a value they can convert
    // themselves, the same reason registration windows are stored as ms.
    function appealWindowOpen(eventId) {
      let res = get(/databases/$(database)/documents/results/$(eventId)).data;
      let s = settings();
      let hours = s.appealWindowHours == null ? 24 : s.appealWindowHours;
      return res.publishStatus == "Published"
        && res.publishedAtMs != null
        && request.time <= timestampOf(res.publishedAtMs + hours * 60 * 60 * 1000);
    }

    // ── Configuration ────────────────────────────────────────────────
    // Public read: the home page needs the fest name, House Managers need
    // the limits, judges need the score scale. None of it is sensitive.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin()
                   || (inBootstrap() && signedIn())
                   // Co-Admins may flip the schedule visibility toggle, and
                   // staff reserve chest / event numbers from the counters.
                   || (isCoAdmin() && docId == "festSettings"
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["scheduleVisible"]))
                   || (isStaff() && docId == "counters");
    }

    match /pointsConfig/{classId} {
      allow read: if true;
      allow write: if isAdmin() || (inBootstrap() && signedIn());
    }

    // ── Accounts ─────────────────────────────────────────────────────
    // The role document is the whole authorisation system. A user may read
    // their own and nothing else; only an Admin may write any of them.
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
                    || (inBootstrap() && request.auth.uid == uid && request.resource.data.role == "admin");
      allow update, delete: if isAdmin();
    }

    // Names shown in the login dropdown. Public by necessity, and harmless:
    // it holds no password material of any kind.
    match /loginDirectory/{slug} {
      allow read: if true;
      allow write: if isAdmin() || (inBootstrap() && signedIn());
    }

    match /houses/{houseId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /judges/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /coAdmins/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /stageManagers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Events, venues, schedule ─────────────────────────────────────
    match /events/{eventId} {
      allow read: if true;
      allow write: if isStaff();
      match /{sub=**} {
        allow read: if true;
        allow write: if isStaff();
      }
    }

    match /venues/{venueId} {
      allow read: if true;
      allow write: if isStaff();
      match /slots/{slotId} {
        allow read: if true;
        allow write: if isStaff();
      }
    }

    // Days of the fest. Public, because the schedule is public.
    match /festDays/{dayId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // v8 — the delete-everything guard. Admin-only both ways: it must never
    // be publicly readable (config/* is, deliberately), because that would
    // let anyone fetch the salted hash to attack offline.
    match /guard/{docId} {
      allow read, write: if isAdmin();
    }

    // v8 — placements for "direct" events, where an Admin picks the order
    // instead of judges scoring. These move points exactly as a score does,
    // so they carry the same published-lock and the same Admin-only rule.
    match /directResults/{docId} {
      allow read: if isStaff() || isJudge();
      // A judge assigned to the event may set placements — a direct event is
      // judged, just by picking a place rather than typing a mark. Same
      // published-lock as scores, because a placement moves points too.
      allow write: if !resultPublished(
                        request.method == "delete"
                          ? resource.data.eventId
                          : request.resource.data.eventId)
                   && (isAdmin()
                       || (isJudge() && assignedToEvent(request.resource.data.eventId)));
    }

    // v8 — substitutions.
    //
    // A House Manager may ASK but never DECIDE: they can create a request
    // for their own house, and only with status "pending". Any write that
    // sets an outcome is staff-only. That split is the whole point of the
    // workflow, so it is enforced here rather than trusted to the UI.
    //
    // Substitution is closed by default per event — an Admin opens it on
    // the events they choose (events/{eventId}.substitutionOpen). The UI
    // hides the request button when it's closed; this re-checks the same
    // flag so a hand-crafted write can't route around that.
    match /substitutions/{id} {
      allow read: if isStaff()
                  || (isHouse() && resource.data.houseId == refId());

      allow create: if isStaff()
                    || (isHouse()
                        && request.resource.data.houseId == refId()
                        && request.resource.data.status == "pending"
                        && get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.substitutionOpen == true);

      // Approving or rejecting is a staff act. A House Manager cannot edit
      // a request once it is in the queue — withdrawing an ask is done by
      // the organiser, so the audit trail stays intact.
      allow update, delete: if isStaff();
    }

    /* v8.8 — house contact details.
     *
     * A SEPARATE COLLECTION, and that is the whole point. `houses` is
     * publicly readable, and Firestore rules are document-level: there is
     * no way to expose a house's name and hide a phone number on the same
     * document. Many of these numbers belong to students, so they live
     * here, staff-only, and reach the public solely through the
     * publicContacts snapshot — which carries only the numbers an Admin
     * explicitly ticked.
     *
     * A House Manager can read their own house's record so they can see
     * and check the numbers held for them.
     */
    match /houseContacts/{houseId} {
      allow read: if isStaff() || (isHouse() && houseId == refId());
      allow write: if isAdmin();
    }

    // Only the ticked-public entries, rebuilt from houseContacts.
    match /publicContacts/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    /* v8.8 — score overrides. Admin-only, and frozen once the event's
     * result is published, on exactly the same condition as `scores` and
     * `entryFlags`: all three move points, so all three lock together.
     * Without the publish check an Admin could change a mark the public had
     * already seen, which is the hole I14 closed for scores. */
    match /scoreOverrides/{id} {
      allow read: if isStaff();
      allow write: if isAdmin()
                   && !resultPublished(request.method == "delete"
                        ? resource.data.eventId
                        : request.resource.data.eventId);
    }

    /* v8.8 — mutual-exclusion constraint groups. Publicly readable
     * because a House Manager's registration path evaluates them, and
     * they describe rules rather than anybody's data. */
    match /constraintGroups/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // v8.8 — manual point adjustments (discipline, bonuses, corrections).
    // Admin-only to WRITE: moving a house total by hand is the single most
    // consequential non-publish act in the app, and a Co-Admin who can score
    // but not publish should not be able to do it either. Publicly readable
    // because the totals they feed are public, and a deduction the affected
    // house cannot see is one it cannot query.
    match /adjustments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // v8.8 — appeals against a published result.
    //
    // judgeUids is denormalised onto the appeal at filing time so a Judge
    // can find their own with a single array-contains query. A list query
    // gated by a get() per document is what failed once already for
    // substitutions: Firestore cannot statically prove a per-document rule
    // holds for every row in an unfiltered query, and rejects the whole
    // list rather than guess.
    //
    // Deciding is Admin-or-Co-Admin, once, and only away from "pending" —
    // an appeal cannot be reopened, the same finality Publish itself has.
    // The decision never touches score data on its own; a House that wins
    // an appeal has its result corrected separately through Score Override
    // or Adjustments, so this collection can never contradict the scoring
    // model it is judging.
    match /appeals/{id} {
      allow read: if isStaff()
                  || (isHouse() && resource.data.houseId == refId())
                  || (isJudge() && request.auth.uid in resource.data.judgeUids);

      allow create: if isHouse()
                    && request.resource.data.houseId == refId()
                    && request.resource.data.status == "pending"
                    && request.resource.data.feeScreenshot is string
                    && request.resource.data.feeScreenshot.size() > 0
                    && settings().appealsEnabled == true
                    && appealWindowOpen(request.resource.data.eventId);

      allow update: if isStaff()
                    && resource.data.status == "pending"
                    && (request.resource.data.status == "upheld"
                        || request.resource.data.status == "overturned")
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(["status", "decision", "decidedBy", "decidedAt", "refundScreenshot"]);

      allow delete: if isAdmin();
    }

    // v8.8 — titles. Hand-awarded, not tied to a scored event, so they carry
    // no publish gate of their own — an Admin decides when to award one and
    // that decision is immediately what the public sees.
    match /titles/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    // v8 — custom leaderboard definitions. Publicly readable because the
    // public results page needs the names of the boards it renders; the
    // tallies themselves live in the snapshot, not here.
    match /leaderboards/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // v8 — Type and Tier vocabularies. Public, same as categories: they are
    // filter values that appear on public listings.
    match /programTypes/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /programTiers/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    /* v8.8 — a House Manager may add participants to their OWN house, and
     * only while the Admin has opened that window.
     *
     * Every clause is load-bearing: without the houseId check a manager
     * could add people to a rival house, and without the window check the
     * roster could be grown after code letters were drawn. eventCounts must
     * start empty so a new participant cannot arrive pre-loaded with
     * entries that never went through the cap transaction. */
    function houseAddOpen() {
      let s = settings();
      return s.houseAddParticipants == true
        && (s.houseAddWindow == null
            || ((s.houseAddWindow.start == null || request.time >= timestamp.value(s.houseAddWindow.start))
             && (s.houseAddWindow.end == null   || request.time <= timestamp.value(s.houseAddWindow.end))));
    }

    // ── Participants ─────────────────────────────────────────────────
    // Publicly readable because the lookup page searches them by chest
    // number and name. Only staff may create or edit.
    //
    // The one exception: a House Manager registering an entry has to bump
    // that participant's event counters. They may change eventCounts and
    // nothing else, and the overall maximum is checked here as well as in
    // the app, so a hand-crafted write cannot exceed it.
    match /participants/{pid} {
      allow read: if true;
      allow create: if isStaff()
                    || (isHouse()
                        && houseAddOpen()
                        && request.resource.data.houseId == refId()
                        // A new participant starts with nothing entered. Any
                        // other starting value would be entries that never
                        // passed through the cap transaction.
                        && request.resource.data.eventCounts.overall == 0);
      allow delete: if isStaff();
      /* The `overall` cap is the server-side BACKSTOP, not the whole cap
       * system. All nine tiers — overall, the four roll-ups and the four
       * classes with their stage splits — are enforced inside the
       * registration transaction in domain/registration.js, which is where
       * they can be checked atomically against the entry tally.
       *
       * Only `overall` is re-checked here, deliberately: every extra tier
       * would mean more get() calls against the rules' budget and more
       * ways for a legitimate write to be refused by a rule that
       * disagreed subtly with the transaction. `overall` is the cap that
       * bounds all the others, so a hand-crafted write still cannot
       * inflate a participant without limit. */
      allow update: if isStaff()
                    || (isHouse()
                        && resource.data.houseId == refId()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["eventCounts"])
                        && (limits().overallMax == null
                            || request.resource.data.eventCounts.overall <= limits().overallMax));
    }

    // Per-house entry tally, one document per (event, house).
    //
    // This exists because the Web SDK cannot run a query inside a
    // transaction, so the per-house entry cap and the duplicate-participant
    // check could not otherwise be made atomic. It is written in the same
    // transaction as the registration it counts.
    match /entryCounts/{tallyId} {
      allow read: if isStaff() || isHouse() || isJudge();
      allow write: if isStaff()
                   || (isHouse()
                       && request.resource.data.houseId == refId()
                       && (!exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
                           || eventDoc(request.resource.data.eventId).maxEntriesPerHouse == null
                           || request.resource.data.count <= eventDoc(request.resource.data.eventId).maxEntriesPerHouse));
    }

    // ── Registrations ────────────────────────────────────────────────
    // NOT public: an entry names the participants behind a code letter, so
    // exposing it would defeat blind judging. Judges never read this.
    match /registrations/{regId} {
      // A Stage Manager reads everything: they have to call the right people
      // to the stage, so the names behind a code letter are exactly what they
      // need. Blind judging is not weakened by this — it is enforced against
      // JUDGES, through judgingEntries, and a Stage Manager cannot score.
      allow read: if isStaff() || isStage() || (isHouse() && resource.data.houseId == refId());

      allow create: if isStaff()
                    || (isHouse()
                        && request.resource.data.houseId == refId()
                        && request.resource.data.codeLetter == ""
                        && registrationOpen(request.resource.data.eventId));

      // A House Manager may withdraw only before code letters are assigned.
      allow delete: if isStaff()
                    || (isHouse() && resource.data.houseId == refId() && resource.data.codeLetter == "");

      // A Stage Manager may letter an entry and nothing else. Restricting the
      // affected keys is what keeps that true: without hasOnly, "may update"
      // would mean they could move an entry to another house or swap its
      // participants, which is a far larger power than assigning a letter.
      allow update: if isStaff()
                    || (isStage()
                        && !resultPublished(resource.data.eventId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(["codeLetter", "codeLetterAssignedBy", "codeLetterAssignedAt"]));
    }

    function registrationOpen(eventId) {
      return eventWindowOpen(eventDoc(eventId));
    }
    function eventWindowOpen(ev) {
      return (
        (ev.registrationStart == null
          ? (settings().registrationWindow.start == null
             || request.time >= timestampOf(settings().registrationWindow.start))
          : request.time >= timestampOf(ev.registrationStart))
      ) && (
        (ev.registrationEnd == null
          ? (settings().registrationWindow.end == null
             || request.time <= timestampOf(settings().registrationWindow.end))
          : request.time <= timestampOf(ev.registrationEnd))
      );
    }
    // Windows are stored as epoch milliseconds so they survive JSON export.
    function timestampOf(ms) {
      return timestamp.value(ms);
    }

    // ── Judging ──────────────────────────────────────────────────────
    // A judge's view of an event. For a blind event this document contains
    // code letters only — the names are not merely hidden in the interface,
    // they are never written here in the first place.
    match /judgingEntries/{eventId} {
      allow read: if isStaff() || (isJudge() && assignedToEvent(eventId));
      // A Stage Manager writes this only as the second half of lettering —
      // judgingEntries is rebuilt from the registrations, so letters that
      // never reached it would leave judges with nothing to score. Frozen
      // once the result is published, on the same reasoning as entryFlags.
      allow write: if isStaff() || (isStage() && !resultPublished(eventId));
    }

    // Who has actually gone on stage. Deliberately NOT a field on the
    // registration and deliberately not entryFlags: this is a running-order
    // aid, and an absence moves points. Keeping them in separate collections
    // means no rule change here can ever be mistaken for the power to mark
    // somebody absent.
    match /stageArrivals/{id} {
      allow read:  if isStaff() || isStage();
      allow write: if isStaff() || isStage();
    }

    match /judgeAssignments/{id} {
      // v8.8 — also House. Filing an appeal denormalises which judges are
      // assigned onto the appeal itself (see /appeals below), which means
      // reading this collection by eventId at that moment. Who is judging
      // an event is not the thing blind judging protects — that is
      // participant identity, kept out of judgingEntries — so this is a
      // minor exposure, not a fairness hole.
      allow read: if isStaff() || isHouse()
                  || (isJudge() && resource.data.judgeUid == request.auth.uid);
      allow write: if isStaff();
    }

    // Judging is Admin-only among staff: a Co-Admin can see scores but not
    // enter or correct them.
    match /scores/{scoreId} {
      allow read: if isStaff() || (isJudge() && resource.data.judgeUid == request.auth.uid);

      // A judge may write only their own score, only for an event they are
      // assigned to, and only a number inside the fest's score scale.
      allow create, update: if !resultPublished(request.resource.data.eventId)
                            && (isAdmin()
                                || (isJudge()
                                    && request.resource.data.judgeUid == request.auth.uid
                                    && assignedToEvent(request.resource.data.eventId)
                                    && request.resource.data.score is number
                                    && request.resource.data.score >= 0
                                    && request.resource.data.score <= settings().scoreScale));

      allow delete: if !resultPublished(resource.data.eventId)
                    && (isAdmin()
                        || (isJudge() && resource.data.judgeUid == request.auth.uid));
    }

    // Absence is its own document rather than a field on the registration,
    // so a judge can mark it without being able to read or alter the entry.
    match /entryFlags/{flagId} {
      allow read: if isStaff() || isJudge();

      // An absence flag moves points exactly as much as a score does, so it
      // is frozen on the same condition.
      allow write: if !resultPublished(
                        request.method == "delete" ? resource.data.eventId : request.resource.data.eventId)
                   && (isStaff()
                       || (isJudge() && assignedToEvent(
                            request.method == "delete" ? resource.data.eventId : request.resource.data.eventId)));
    }

    // ── Results ──────────────────────────────────────────────────────
    // Staff-only. The public never reads this collection; it reads the
    // publicResults snapshots instead.
    //
    // This is where Publish is enforced as Admin-only: a Co-Admin may
    // create, finalize and stage, but any write that sets publishStatus to
    // "Published" is rejected unless the caller is an Admin.
    match /results/{eventId} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.publishStatus != "Published";
      allow update: if isStaff()
                    && (isAdmin() || request.resource.data.publishStatus != "Published");
      allow delete: if isAdmin();
    }

    // ── Public snapshots ─────────────────────────────────────────────
    // Everything the public sees, pre-built. Small, cheap to read, and the
    // only collections a signed-out visitor ever touches.
    match /publicResults/{eventId} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /publicLeaderboard/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /publicSchedule/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }
    // Written by staff on publish, and by a House Manager when they
    // register one of their own participants.
    match /participantPublic/{pid} {
      allow read: if true;
      allow write: if isStaff() || isHouse();
    }

    // Saved certificate and poster designs. Readable by staff only — they
    // are working documents, not public content.
    match /designs/{designId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // Anything not named above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
